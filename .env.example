# ====================
# MinerU API
# ====================
MINERU_API_TOKEN=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# Model Source & Cache
# ====================
# Model source (ModelScope / HuggingFace)
MINERU_MODEL_SOURCE=modelscope
# ModelScope offline mode (1=enabled)
MODELSCOPE_OFFLINE=1
# ModelScope model cache path
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face cache path
HF_HOME=D:/ai_models/huggingface_cache
# Temp files root directory
DATA_BASED_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API Key (OpenAI compatible)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Base URL (Alibaba Cloud DashScope)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# Default LLM model
LLM_DEFAULT_MODEL=qwen-flash
# Default temperature (0-1, lower is more stable)
LLM_DEFAULT_TEMPERATURE=0.1
# Vision Language model
VL_MODEL=qwen3-vl-flash
# Item name recognition model
ITEM_MODEL=qwen-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 model local path
BGE_M3_PATH=D:/ai_models/modelscope_cache/models/BAAI/bge-m3
# BGE-M3 model name
BGE_M3=BAAI/bge-m3
# Embedding model device
BGE_DEVICE=cuda:0
# Use half precision (True/False)
BGE_FP16=True
# BGE reranker model path
BGE_RERANKER_LARGE=D:/ai_models/modelscope_cache/models/BAAI/bge-reranker-large
# Reranker model device
BGE_RERANKER_DEVICE=cuda:0
# Reranker half precision
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# Embedding vector dimension (OpenAI text-embedding-v4)
EMBEDDING_DIM=1536
# Embedding model name
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus connection URL
MILVUS_URL=http://localhost:19530
# Knowledge base chunks collection
CHUNKS_COLLECTION=kb_chunks
# Item names collection
ITEM_NAME_COLLECTION=kb_item_names
# Similarity metric type
MILVUS_METRIC_TYPE=COSINE
# Minimum cosine similarity threshold
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB connection URL
MONGO_URL=mongodb://localhost:27017
# Database name
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO endpoint
MINIO_ENDPOINT=localhost:9000
# Access key
MINIO_ACCESS_KEY=minioadmin
# Secret key
MINIO_SECRET_KEY=minioadmin
# Bucket name
MINIO_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services
# ====================
# MCP Web search service URL
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ====================
# Reranker
# ====================
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT=针对给定的查询，检索能够解答该查询的相关段落
